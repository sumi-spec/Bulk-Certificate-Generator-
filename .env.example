# Application Configuration
APP_NAME="Bulk Certificate Generator"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration
# PostgreSQL format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local testing without Postgres: sqlite:///./cert_dev.db
DATABASE_URL="postgresql://cert_user:cert_password@localhost:5432/cert_db"

# Redis & Celery Configuration
# Redis format: redis://<host>:<port>/<db_index>
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# File Storage Configuration
STORAGE_DIR="./storage/certificates"

# Security & CORS
ALLOWED_ORIGINS="*"
API_V1_STR="/api/v1"

# Bulk Job Limits
MAX_RECIPIENTS_PER_JOB=5000
CHUNK_SIZE=50
