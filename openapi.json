{
  "openapi": "3.1.0",
  "info": {
    "title": "Bulk Certificate Generator",
    "description": "### Bulk Certificate Generator Backend API\n\nAn enterprise-grade, asynchronous bulk certificate generation engine.\n\n**Key Features:**\n- Asynchronous bulk processing via Celery & Redis\n- Fault-tolerant partial success: invalid recipients fail independently\n- ReportLab vector PDF rendering with dynamic font scaling & decorative borders\n- Idempotent job submission with `Idempotency-Key` headers\n- Cryptographic SHA256 integrity checksums\n- Sliding-window rate limiting & path-traversal prevention\n",
    "contact": {
      "name": "Engineering Team",
      "url": "https://github.com/org/bulk-certificate-generator"
    },
    "license": {
      "name": "MIT License",
      "url": "https://opensource.org/licenses/MIT"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "System Health & Readiness Probe",
        "description": "Checks operational health of API service, database connection, and redis broker.\nReturns 200 OK when services are reachable, or 503 Service Unavailable if degraded.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/certificate-jobs": {
      "post": {
        "tags": [
          "Certificate Jobs"
        ],
        "summary": "Create a bulk certificate generation job",
        "description": "Submits a list of recipients and event metadata. Processing runs asynchronously in the background.",
        "operationId": "create_certificate_job_api_v1_certificate_jobs_post",
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/JobCreate"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobCreatedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/certificate-jobs/{job_id}": {
      "get": {
        "tags": [
          "Certificate Jobs"
        ],
        "summary": "Retrieve job status and progress counters",
        "description": "Poll this endpoint to monitor real-time processing status, success/failure counts, and timestamps.",
        "operationId": "get_job_status_api_v1_certificate_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/certificate-jobs/{job_id}/results": {
      "get": {
        "tags": [
          "Certificate Jobs"
        ],
        "summary": "Retrieve itemized recipient outcomes and error messages",
        "description": "Returns a paginated list of recipient results, including certificate IDs for successes and error details for failures.",
        "operationId": "get_job_results_api_v1_certificate_jobs__job_id__results_get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Job Id"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number starting at 1",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number starting at 1"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Items per page",
              "default": 50,
              "title": "Page Size"
            },
            "description": "Items per page"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RecipientStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by recipient status",
              "title": "Status"
            },
            "description": "Filter by recipient status"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobResultsPaginatedResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/certificates/{certificate_id}": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Download or stream an issued certificate PDF",
        "description": "Streams the issued PDF certificate file.",
        "operationId": "download_certificate_api_v1_certificates__certificate_id__get",
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Certificate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Returns the generated vector PDF certificate binary file.",
            "content": {
              "application/pdf": {}
            }
          },
          "404": {
            "description": "Certificate record or storage file not found."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/certificates/{certificate_id}/metadata": {
      "get": {
        "tags": [
          "Certificates"
        ],
        "summary": "Retrieve certificate metadata and checksum",
        "description": "Retrieves verification metadata, recipient name, issue date, file size, and SHA256 integrity hash.",
        "operationId": "get_certificate_metadata_api_v1_certificates__certificate_id__metadata_get",
        "parameters": [
          {
            "name": "certificate_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Certificate Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CertificateMetadataResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CertificateMetadataResponse": {
        "properties": {
          "certificate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Certificate Id"
          },
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "recipient_id": {
            "type": "string",
            "format": "uuid",
            "title": "Recipient Id"
          },
          "recipient_name": {
            "type": "string",
            "title": "Recipient Name"
          },
          "recipient_email": {
            "type": "string",
            "title": "Recipient Email"
          },
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "issuer_name": {
            "type": "string",
            "title": "Issuer Name"
          },
          "issue_date": {
            "type": "string",
            "format": "date",
            "title": "Issue Date"
          },
          "file_name": {
            "type": "string",
            "title": "File Name"
          },
          "file_size_bytes": {
            "type": "integer",
            "title": "File Size Bytes"
          },
          "sha256_checksum": {
            "type": "string",
            "title": "Sha256 Checksum"
          },
          "issued_at": {
            "type": "string",
            "format": "date-time",
            "title": "Issued At"
          }
        },
        "type": "object",
        "required": [
          "certificate_id",
          "job_id",
          "recipient_id",
          "recipient_name",
          "recipient_email",
          "event_name",
          "issuer_name",
          "issue_date",
          "file_name",
          "file_size_bytes",
          "sha256_checksum",
          "issued_at"
        ],
        "title": "CertificateMetadataResponse",
        "description": "Metadata response for an issued certificate."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobCreate": {
        "properties": {
          "event_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Event Name",
            "description": "Course or event name"
          },
          "issuer_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Issuer Name",
            "description": "Name of issuing organization"
          },
          "issue_date": {
            "type": "string",
            "format": "date",
            "title": "Issue Date",
            "description": "Date printed on certificate (YYYY-MM-DD)"
          },
          "recipients": {
            "items": {
              "$ref": "#/components/schemas/RecipientCreate"
            },
            "type": "array",
            "maxItems": 5000,
            "minItems": 1,
            "title": "Recipients",
            "description": "List of recipients to generate certificates for (up to 5000)"
          }
        },
        "type": "object",
        "required": [
          "event_name",
          "issuer_name",
          "issue_date",
          "recipients"
        ],
        "title": "JobCreate",
        "description": "Schema for submitting a bulk certificate generation request."
      },
      "JobCreatedResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_recipients": {
            "type": "integer",
            "title": "Total Recipients"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "status",
          "total_recipients",
          "created_at"
        ],
        "title": "JobCreatedResponse",
        "description": "Immediate response after submitting a bulk generation job."
      },
      "JobResultsPaginatedResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_records": {
            "type": "integer",
            "title": "Total Records"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          },
          "results": {
            "items": {
              "$ref": "#/components/schemas/RecipientResultResponse"
            },
            "type": "array",
            "title": "Results"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "page",
          "page_size",
          "total_records",
          "total_pages",
          "results"
        ],
        "title": "JobResultsPaginatedResponse",
        "description": "Paginated list of itemized recipient results and error reasons."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "PROCESSING",
          "COMPLETED",
          "COMPLETED_WITH_ERRORS",
          "FAILED"
        ],
        "title": "JobStatus",
        "description": "Job status lifecycle state."
      },
      "JobStatusResponse": {
        "properties": {
          "job_id": {
            "type": "string",
            "format": "uuid",
            "title": "Job Id"
          },
          "event_name": {
            "type": "string",
            "title": "Event Name"
          },
          "issuer_name": {
            "type": "string",
            "title": "Issuer Name"
          },
          "issue_date": {
            "type": "string",
            "format": "date",
            "title": "Issue Date"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "total_recipients": {
            "type": "integer",
            "title": "Total Recipients"
          },
          "processed_count": {
            "type": "integer",
            "title": "Processed Count"
          },
          "success_count": {
            "type": "integer",
            "title": "Success Count"
          },
          "failure_count": {
            "type": "integer",
            "title": "Failure Count"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "completed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "event_name",
          "issuer_name",
          "issue_date",
          "status",
          "total_recipients",
          "processed_count",
          "success_count",
          "failure_count",
          "created_at"
        ],
        "title": "JobStatusResponse",
        "description": "Comprehensive status and progress metrics for a generation job."
      },
      "RecipientCreate": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Name",
            "description": "Full name of the recipient"
          },
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email",
            "description": "Valid email address of the recipient"
          },
          "custom_identifier": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Identifier",
            "description": "Optional unique identifier like student ID or employee ID"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "title": "RecipientCreate",
        "description": "Schema for individual recipient within a bulk job creation request."
      },
      "RecipientResultResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "custom_identifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Custom Identifier"
          },
          "status": {
            "$ref": "#/components/schemas/RecipientStatus"
          },
          "certificate_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Certificate Id"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "processed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Processed At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "status",
          "created_at"
        ],
        "title": "RecipientResultResponse",
        "description": "Itemized execution result for an individual recipient."
      },
      "RecipientStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "SUCCESS",
          "FAILED"
        ],
        "title": "RecipientStatus",
        "description": "Individual recipient processing status."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "System readiness, liveness, and component connectivity probes (Database, Redis broker)."
    },
    {
      "name": "Certificate Jobs",
      "description": "Asynchronous bulk generation job creation, real-time progress polling, and paginated recipient results."
    },
    {
      "name": "Certificates",
      "description": "Authorized binary streaming of vector PDF certificates and cryptographic SHA256 integrity verification."
    }
  ]
}