# ==============================================================================
# Bulk Certificate Generator - Production Environment Configuration Template
# ==============================================================================
# WARNING: NEVER commit the active .env or .env.production file containing real
# credentials to version control. Keep this template updated for documentation.
#
# Generate cryptographically secure random secrets using:
#   openssl rand -hex 32
# ==============================================================================

# Core Application Settings
APP_NAME=Bulk Certificate Generator API
APP_ENV=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Relational Database (Managed PostgreSQL / RDS)
# In production, use a hardened managed database with SSL enabled.
# Example: postgresql://<user>:<password>@<db-host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql://cert_prod_user:CHANGE_ME_STRONG_DB_PASSWORD@postgres-host:5432/cert_prod_db?sslmode=require

# Asynchronous Broker & Results Backend (Redis with AOF & Password Auth)
# Example: redis://:<redis-password>@<redis-host>:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis-host:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis-host:6379/0

# Persistent Certificate Storage
# Map this to a mounted persistent volume (AWS EBS, DigitalOcean Volume)
# or S3-backed FUSE mount / EFS mount.
STORAGE_DIR=/app/storage/certificates

# Security & Access Control
# API Key for authenticating ingest clients (leave blank only if using external gateway auth)
# Generate with: openssl rand -hex 32
API_KEY=prod_live_sec_CHANGE_ME_64_CHARACTER_RANDOM_HEX_KEY

# CORS Configuration (Comma-separated list of explicit trusted domains)
# NEVER use wildcard '*' in production
ALLOWED_ORIGINS=https://certs.yourdomain.com,https://app.yourdomain.com

# Ingestion & Operational Limits
MAX_REQUEST_BODY_BYTES=10485760
MAX_RECIPIENTS_PER_JOB=5000
CHUNK_SIZE=50
